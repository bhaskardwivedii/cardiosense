# Copy to .env and adjust. All values are optional in development.
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-string          # python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql://cardio:cardio@db:5432/cardiosense   # default: SQLite file
ADMIN_EMAIL=admin@yourclinic.org
ADMIN_PASSWORD=choose-a-strong-password
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTES=720
MAX_BATCH_ROWS=10000
